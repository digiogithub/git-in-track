+			again := f.impact(f.resolver(fixtureGraph(), nil), q)
+			a, _ := json.Marshal(first)
+			b, _ := json.Marshal(again)
+			if !bytes.Equal(a, b) {
+				t.Errorf("two runs differ:\n%s\n%s", a, b)
+			}
+		})
+	}
+}
