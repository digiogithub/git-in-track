+			if got["ACME-SP-0001.R1"] != tc.r1 || got["ACME-SP-0001.R2"] != tc.r2 {
+				t.Errorf("R1, R2 = %+v, %+v, want %+v, %+v (hits %+v)",
+					got["ACME-SP-0001.R1"], got["ACME-SP-0001.R2"], tc.r1, tc.r2, first.Hits)
