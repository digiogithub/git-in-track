+	}
+
+	todo := decode[listResult](t, call(t, v, "requirement.list", map[string]any{"spec": "DEMO-SP-0001", "status": []string{"backlog"}}))
+	if todo.Total != 1 || todo.Requirements[0].Ref != "DEMO-SP-0001.R2" {
