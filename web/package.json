{
  "name": "git-in-track-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "git-in-track web application (React + Vite + TypeScript)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:companion": "VITE_FORCE_PROVIDER=companion vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "wasm:smoke": "node ../scripts/wasm-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
