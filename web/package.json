    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "github-slugger": "2.0.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "lucide-react": "1.40.0",
    "mermaid": "11.17.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.4.3",
    "tailwind-merge": "2.6.1",
    "unified": "11.0.5",
