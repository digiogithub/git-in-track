# .pando.toml — generated by `gintrack agent init` for the repository {{ toml .RepoID }}.
#
# One Pando process serves one repository: `pando agui-serve --cwd` chdirs once
# and takes a `.pando/ipc.lock` per working directory, so there is exactly one
# of these files per repository and no multi-repository variant. Pando merges
# this file over the global ~/.config/pando/.pando.toml.
#
# Full reference: docs/20-agent-interface.md. The authority for the key names is
# Pando's internal/config/config.go, not pando-schema.json, which is stale.
{{- if .Token }}
#
# SECURITY — this file carries the companion bearer token in
# [MCPServers.gintrack.Headers]. It is written with mode 0600 and it must never
# be committed: add `.pando.toml` to .gitignore or .git/info/exclude.
{{- end }}

# =============================================================================
# AG-UI adapter — what the browser talks to, through the companion proxy
# =============================================================================
[AGUI]
Enabled = true
Path = {{ toml .AGUIPath }}
# A dedicated listener on loopback: nothing else of Pando's API is exposed on it.
Host = {{ toml .AGUIHost }}
Port = {{ .AGUIPort }}
Agents = ['coder']
# AllowedOrigins stays EMPTY on purpose. The companion proxy strips the browser
# `Origin` header, and Pando only runs its CORS check when that header is
# present, so listing the companion origin here would add nothing and would
# widen the surface for anything that talks to this port directly.
AllowedOrigins = []
RequireToken = true
# FrontendTools is stated explicitly because Pando's documented default (true)
# only applies while the key is absent from every config file: writing an [AGUI]
# section without it decodes to the zero value and silently turns it off.
FrontendTools = true
# HITL: every tool call the agent wants to make is surfaced to the browser for
# approval. Together with the Tools allow-list below this is the interim
# boundary — see the caveat in docs/20-agent-interface.md.
HumanInTheLoop = true
AutoApprove = false
# The companion imposes its own per-user and global in-flight caps; this is
# Pando's own backstop (a run over the cap is refused with 503 + Retry-After).
MaxConcurrentRuns = {{ .MaxConcurrentRuns }}
Persona = {{ toml .Persona }}
# Tools is a glob allow-list (path.Match against each tool's Info().Name),
# applied after the agent's tool set is built. It is subtractive only. Without
# it the AG-UI agent is Pando's full coder agent, bash/edit/write included.
# MCP tools are named `<server>_<tool>`, hence the `gintrack_*` glob — but only
# on Pando's direct registration path. Its MCP gateway (activated by
# ToolDiscovery whenever an [MCPServers] entry exists) hides every MCP tool
# behind `tool_search` or the generic `mcp_call_tool` proxy, which this list
# would strip; the [ToolDiscovery] and [MCPGateway] sections below turn the
# gateway off so the tools keep their names and their per-tool approval.
Tools = [
{{- range .Tools }}
  {{ toml . }},
{{- end }}
]
# No delegation: the backlog assistant answers questions, it does not spawn
# sub-agents. An explicit false drops every mesnada_* tool even with Tools set.
Mesnada = false

# A named profile, addressed as POST {{ .AGUIPath }}/{{ .Persona }}. It inherits
# this section's Tools/Mesnada/Persona unless it overrides them, and `Base` is
# the built-in agent it takes its model and token configuration from.
[AGUI.Profiles.{{ .Persona }}]
Base = 'coder'
Prompt = 'Answer questions about the backlog and knowledge base of this repository. Always cite the item ids you used. Never edit files.'

# =============================================================================
# Tool routing — keep the MCP gateway off
# =============================================================================
# With an [MCPServers] entry present, ToolDiscovery (default true) activates
# Pando's MCP gateway: MCP tools stop being registered as `<server>_<tool>` and
# are reached through `tool_search` or the generic `mcp_call_tool` proxy, which
# neither the [AGUI] Tools allow-list nor the per-tool permission prompt can
# see. Both keys are written explicitly because an absent key does not mean
# "default": a section that exists without them decodes to the zero value.
[ToolDiscovery]
Enabled = false
Mode = 'off'

[MCPGateway]
Enabled = false

# =============================================================================
# Personas and skills — written next to this file by `gintrack agent init`
# =============================================================================
[PersonaAutoSelect]
# Enabled stays false: this only tells Pando where to load persona files from,
# which it does regardless of automatic selection.
Enabled = false
PersonaPath = './agents/personas'

[Skills]
Enabled = true
Paths = ['./agents/skills']

# =============================================================================
# The gintrack MCP server — how Pando reads and writes the backlog
# =============================================================================
[MCPServers.gintrack]
Type = 'streamable-http'
URL = {{ toml .MCPURL }}
Timeout = '60s'

[MCPServers.gintrack.Headers]
{{- if .Token }}
Authorization = {{ toml .BearerHeader }}
{{- else }}
# No companion token was configured when this file was generated. Start the
# companion with `gintrack serve --token <value>` (or set server.token in the
# gintrack configuration) and re-run `gintrack agent init --force`, or paste the
# header by hand:
# Authorization = 'Bearer <companion token>'
{{- end }}

# =============================================================================
# Remembrances — the semantic index over the exported backlog corpus
# =============================================================================
[Remembrances]
Enabled = true
# The corpus `gintrack serve` exports: one Markdown file per item and per KB
# page, outside the repository so nothing exported is ever committed. Pando's
# directory walk has no hidden-directory or node_modules exclusion, so this must
# point at the corpus directory and never at a repository root.
KBPath = {{ toml .KBPath }}
KBAutoImport = true
# KBWatch stays FALSE. The watcher re-writes documents it processes without
# parsing their front matter, so every incremental edit strips the metadata the
# exporter wrote. Re-sync is driven by the companion instead.
KBWatch = false

# =============================================================================
# Pando's own MCP server — off
# =============================================================================
[MCPServer]
# HttpEnabled exposes Pando's own MCP transport on :9777. Leave it off unless
# something actually needs it: it auto-approves every tool call globally, so any
# client that can reach the port drives a code-executing agent. If you do turn
# it on, set HttpToken and keep HttpHost on loopback.
HttpEnabled = false
StdioEnabled = true
