{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git-in-track.dev/schema/memory.schema.json",
  "title": "git-in-track memory",
  "description": "Front matter of a memory item (docs/03-data-model.md section 23, ADR-044).",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "created",
    "updated",
    "memory"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,9}-MEM-[0-9]{4,}$"
    },
    "type": {
      "const": "memory"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "superseded",
        "cancelled",
        "forgotten"
      ],
      "description": "The fixed memory lifecycle; project.yaml cannot redefine it."
    },
    "priority": {
      "$ref": "common.defs.json#/$defs/priority"
    },
    "author": {
      "$ref": "common.defs.json#/$defs/handle"
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/label"
      }
    },
    "spent": {
      "type": "number",
      "minimum": 0
    },
    "created": {
      "$ref": "common.defs.json#/$defs/timestamp"
    },
    "updated": {
      "$ref": "common.defs.json#/$defs/timestamp"
    },
    "started": {
      "$ref": "common.defs.json#/$defs/timestamp"
    },
    "closed": {
      "$ref": "common.defs.json#/$defs/timestamp"
    },
    "due": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/link"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/linkTarget"
      },
      "description": "Shorthand for links of kind blocks, normalised into links on the next write (section 12.2)."
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/linkTarget"
      },
      "description": "Shorthand for links of kind blocked_by, normalised into links on the next write (section 12.2)."
    },
    "external": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/external"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "custom": {
      "type": "object"
    },
    "inbox": {
      "$ref": "common.defs.json#/$defs/inbox"
    },
    "memory": {
      "$ref": "common.defs.json#/$defs/memory"
    },
    "deleted": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x-": true
  }
}
