{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git-in-track.dev/schema/project.schema.json",
  "title": "git-in-track project.yaml",
  "description": "The project file .pmngr/project.yaml (docs/03-data-model.md section 6).",
  "type": "object",
  "required": [
    "schema",
    "key",
    "name",
    "workflow"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,9}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "wikilinks": {
          "type": "boolean"
        },
        "mermaid": {
          "type": "boolean"
        },
        "math": {
          "type": "boolean"
        },
        "footnotes": {
          "type": "boolean"
        },
        "callouts": {
          "type": "boolean"
        },
        "attachments_dir": {
          "type": "string"
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "statuses"
      ],
      "additionalProperties": false,
      "properties": {
        "initial": {
          "$ref": "common.defs.json#/$defs/statusId"
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "category"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.defs.json#/$defs/statusId"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "todo",
                  "in_progress",
                  "done",
                  "cancelled",
                  "triage"
                ]
              },
              "wip": {
                "type": "integer",
                "minimum": 0
              },
              "color": {
                "type": "string"
              },
              "terminal": {
                "type": "boolean"
              }
            }
          }
        },
        "transitions": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "$ref": "common.defs.json#/$defs/statusId"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "common.defs.json#/$defs/statusId"
            }
          }
        }
      }
    },
    "id_allocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "scan",
            "ranges"
          ]
        },
        "write_counters": {
          "type": "boolean"
        },
        "counters": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "epic",
              "story",
              "task",
              "milestone",
              "spec"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "reserved": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "epic",
              "story",
              "task",
              "milestone",
              "spec"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "redirects": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.defs.json#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "common.defs.json#/$defs/id"
          }
        },
        "ranges": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.defs.json#/$defs/handle"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "epic",
                "story",
                "task",
                "milestone",
                "spec"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "common.defs.json#/$defs/label"
          },
          "color": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "priorities": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/priority"
      }
    },
    "estimation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale": {
          "enum": [
            "fibonacci",
            "linear",
            "tshirt",
            "none"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "track_hours": {
          "type": "boolean"
        }
      }
    },
    "defaults": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "epic",
          "story",
          "task",
          "milestone",
          "spec"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "common.defs.json#/$defs/statusId"
          },
          "priority": {
            "$ref": "common.defs.json#/$defs/priority"
          },
          "assignees": {
            "type": "array",
            "items": {
              "$ref": "common.defs.json#/$defs/handle"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "common.defs.json#/$defs/label"
            }
          }
        }
      }
    },
    "custom_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "string",
              "text",
              "number",
              "bool",
              "date",
              "timestamp",
              "enum",
              "person",
              "list",
              "url"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "type": "string"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "enum": [
                "epic",
                "story",
                "task",
                "milestone",
                "spec"
              ]
            }
          },
          "default": {},
          "description": {
            "type": "string"
          }
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "handle"
        ],
        "additionalProperties": false,
        "properties": {
          "handle": {
            "$ref": "common.defs.json#/$defs/handle"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "web_url": {
          "type": "string"
        }
      }
    },
    "integrations": {
      "type": "object",
      "description": "External trackers this backlog mirrors (section 6.5). Validated by the companion as E-PROJ-INTEGRATION; credentials never appear here.",
      "additionalProperties": {
        "type": "object"
      }
    },
    "specs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lint": {
          "anyOf": [
            {
              "enum": [
                "off",
                "warning",
                "error"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "severity": {
                  "enum": [
                    "off",
                    "warning",
                    "error"
                  ]
                },
                "rules": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "LINT-REQ-STATEMENT",
                      "LINT-REQ-SCENARIO",
                      "LINT-REQ-WHEN-THEN",
                      "LINT-REQ-VAGUE",
                      "LINT-REQ-MULTI"
                    ]
                  },
                  "additionalProperties": {
                    "enum": [
                      "off",
                      "warning",
                      "error"
                    ]
                  }
                },
                "vague_words": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false
}
